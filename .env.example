# LiteRTLM AI Gateway — environment configuration
# Copy this file to .env and fill in real values before running.
# .env is excluded from version control.

# Secret used to sign JWT access and refresh tokens.
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret

# Single admin user credentials for JWT login (POST /api/auth/login).
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-password
