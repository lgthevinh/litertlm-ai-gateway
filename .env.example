# LiteRTLM AI Gateway — environment configuration
# Copy this file to .env and fill in real values before running.
# .env is excluded from version control.

# Secret used to sign JWT access and refresh tokens.
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret

# Single admin user credentials for JWT login (POST /api/auth/login).
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-password

# Path to the enterprise docs directory used by rogo_list_docs and rogo_read_doc tools.
# Accepts absolute or relative paths. Relative paths are resolved from the working directory
# (i.e. where the JAR is run from).
# Defaults to ./rogodocs if not set.
# ROGO_DOCS_DIR=./rogodocs
